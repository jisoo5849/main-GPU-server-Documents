# 메인 GPU 서버 설정. 이 파일을 .env로 복사한 뒤 값을 바꾼다.
#   cp .env.example .env
# 규칙: 한 줄에 KEY=값 하나. 값에 공백·따옴표·# ·$ 를 넣지 않는다 (설치 스크립트와 docker compose 가 같이 읽는다).
#        비밀번호는 영문 대소문자·숫자·- _ . 만으로 길게 만든다.

# ── 저장소 경로 (install/02-storage.sh 가 만든다) ──
# 환경(ComfyUI·노드·Python)과 스냅샷. 반드시 btrfs 파티션이어야 한다.
MGS_ENVS=/srv/envs
# 공용 모델 저장소. NVMe 권장. 컨테이너에는 읽기 전용으로 연결된다.
MGS_MODELS=/srv/models
# 결과 저장소. Samba \\main\results 로 공유되며 누구나 읽기·쓰기 가능.
MGS_RESULTS=/srv/results
# PostgreSQL 데이터
MGS_PG=/srv/pg
# 편집·실행 컨테이너에 읽기 전용으로 연결되는 공용 파일(모델 경로 설정, 브리지 노드)
MGS_RUNTIME=/opt/mgs

# ── 사용자 그룹 (02-storage.sh 와 같은 값) ──
MGS_GROUP=comfyusers
MGS_GID=2000

# ── DB ──
POSTGRES_PASSWORD=change-this-password

# ── 허브 ──
# 세션 서명 등에 쓰는 비밀값. 아래 명령으로 만든다: openssl rand -hex 32
HUB_SECRET=change-this-secret
# 메인 주소(작업자 PC에서 접속하는 이름 또는 IP)
HUB_PUBLIC_HOST=main
# Docker 가 직접 여는 포트(Open WebUI 8090)를 붙일 메인의 사무실 쪽 IP. 방화벽이 적용되지 않으므로 반드시 LAN IP 로.
# VPN(Tailscale) 주소는 넣지 않는다: tailscaled 가 늦게 뜨면 컨테이너가 시작하지 못한다. 그래서 8090 은 사무실 전용.
HUB_BIND_IP=192.168.0.10
# 로그인·모델 선택 화면 포트
HUB_PORTAL_PORT=80
# LLM·임베딩 중계 포트 (Ollama와 같은 주소 형식)
HUB_LLM_PORT=11434
# 사용자·프로젝트 환경마다 하나씩 쓰는 포트 범위
HUB_ENV_PORT_START=8101
HUB_ENV_PORT_END=8130

# ── ComfyUI 환경 ──
COMFY_RUNTIME_IMAGE=mgs/comfy-runtime:1
COMFY_TAG=v0.42.5
COMFY_TEMPLATE=comfy-v0.42.5-cu130
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# 편집 화면에서 CUDA가 없어 못 불러온 노드가 있어도 실행 접수를 허용 (실제 검사는 실행 공간에서 다시 한다)
ACCEPT_MISSING_NODES=true

# ── GPU 규칙 ──
GPU_INDEX=0
# 작업 하나의 최대 실행 시간(초). 긴 영상 작업에 맞춰 조정
JOB_MAX_SECONDS=14400
# 메모리 해제 확인 여유값(MB)
VRAM_WORKER_MARGIN_MB=512
VRAM_TOTAL_MARGIN_MB=768
VRAM_IDLE_MARGIN_MB=256
# 이보다 작은 메인 화면 프로그램의 GPU 사용(MB)은 감시 기록에 남기지 않음 (사용량을 못 읽은 0 은 남김)
FOREIGN_INCIDENT_MIN_MB=256

# ── Ollama ──
# 설치 후 실제 사용하는 버전으로 고정하는 것을 권장
OLLAMA_VERSION=latest
OLLAMA_UPSTREAM=http://127.0.0.1:11435

# ── 프롬프트 확장·결과 자동 검사 (ComfyUI '메인 GPU' 패널) ──
# 메인 Ollama 에 받아 둔 모델 이름. 둘 다 다른 작업과 같은 GPU 대기열을 거친다.
PROMPT_EXPAND_MODEL=qwen3.8:27b
# 규칙 검사에서 걸리면 고쳐 쓰게 하는 최대 횟수
PROMPT_EXPAND_REPAIR_ROUNDS=2
IMAGE_INSPECT_MODEL=qwen3-vl:8b-instruct
# 대기열이 길 때 확장·검사 요청이 차례를 기다리는 최대 시간(초)
HELPER_WAIT_SECONDS=900
# 제작진 모드(docs/crew-mode.md): auto 는 제품·공간·풍경 요청에만 전문가 지식 초안을 먼저 받고(패널 체크박스를 따름), off 는 서버에서 끈다
CREW_MODE=auto
# 제작진 초안이 규칙에 걸릴 때 고쳐 쓰게 하는 최대 횟수 (그래도 걸리면 기존 도우미로 처리)
CREW_REPAIR_ROUNDS=1
# 요청에 이 이름(캐릭터 정본)이 있으면 제작진 모드를 건너뛴다. 쉼표로 구분
CREW_GUARD_NAMES=니키,niki,푸토르,putor,퀼린스,quillins,제임스,james,베스,beth,타오바,taoba,일리아,ilia,일로케,iloke,일루키,iluki
# 영상 렌더러(docs/video-renderer.md): 첫 화면 이미지를 읽는 시각 모델 (비우면 IMAGE_INSPECT_MODEL)
VIDEO_FRAME_MODEL=
# 움직임 초안이 규칙에 걸릴 때 고쳐 쓰게 하는 최대 횟수
VIDEO_REPAIR_ROUNDS=1
# 허브 안 LLM 호출의 문맥 길이(토큰). 장문 영상 프롬프트(러다이트식)는 지시문 + 답 + 고쳐 쓰기 1회가 Ollama 기본(4096)을 넘는다. 0 이면 Ollama 기본값
HELPER_NUM_CTX=12288

# ── 네트워크 ──
# 접속을 허용할 사무실 네트워크 대역
LAN_SUBNET=192.168.0.0/24
EDITOR_SUBNET=172.30.0.0/24
WORKER_SUBNET=172.30.1.0/24

# ── VPN (사무실 밖 작업자, install/06-vpn.sh, docs/vpn-tailscale.md) ──
# 04-firewall.sh 가 이 인터페이스에 포털·작업공간·LLM 포트를 연다. 비우면 VPN 규칙을 만들지 않는다.
VPN_IFACE=tailscale0
# VPN 으로 SSH(22) 허용. 기본은 막음 (관리자가 밖에서 점검할 때만 true, Tailscale 정책으로 관리자 기기만)
VPN_ALLOW_SSH=false
# VPN 으로 결과 폴더(Samba) 허용. 기본은 막음
VPN_ALLOW_SAMBA=false

# ── 채팅 스튜디오 (docs/chat-studio-design.md) ──
# false 면 /studio 를 열지 않는다 (화면은 503 안내). 기본은 꺼짐: 7.2 를 마치고 시범 사용자를 넣은 뒤 켠다
STUDIO_ENABLED=false
# 채팅을 쓸 수 있는 사용자 (쉼표로 구분, 비우면 모두). P1 시범용 (D16)
STUDIO_ALLOWED_USERS=
# 채팅 작업이 실행되는 시스템 작업공간 (7.2 에서 만든다)
STUDIO_ENV_SLUG=studio-chat
# 업로드: 받는 크기(MB), 받는 긴 변, 저장할 때 줄이는 긴 변, 사용자별 용량(MB)
STUDIO_UPLOAD_MAX_MB=20
STUDIO_UPLOAD_MAX_SIDE=4096
STUDIO_UPLOAD_STORE_SIDE=2048
STUDIO_UPLOAD_QUOTA_MB=2048
# 업로드 볼륨(MGS_ENVS) 여유 공간이 이보다 작으면(GB) 업로드 거부, 보내지 않은 첨부를 지우기까지 시간
STUDIO_MIN_FREE_GB=50
STUDIO_UNSENT_HOURS=24
# 사용자당 동시에 진행하는 요청, 열린 요청(대기·진행·승인 대기), 분당 메시지
STUDIO_MAX_ACTIVE_PER_USER=2
STUDIO_MAX_OPEN_PER_USER=5
STUDIO_MAX_MESSAGES_PER_MIN=10
# 감독이 LLM 차례를 기다리는 최대 시간(초). 점검·정지 시간은 세지 않는다. 패널의 HELPER_WAIT_SECONDS 와 따로 둔다 (D14)
STUDIO_LLM_WAIT_SECONDS=3600
# LLM 차례 하나의 실행 한도(초)
STUDIO_LLM_TURN_SECONDS=900
# 같은 레시피로 접수 검증이 잇달아 실패하면 레시피를 끄는 횟수
STUDIO_RECIPE_FAIL_LIMIT=3
# 긴 영상 계획 확인(Ask) 기준(초). 0 이면 Ask 를 켠 대화의 모든 영상에 계획 카드
# 글→영상을 내부에서 '장면 이미지 → 그 이미지로 영상' 두 단계로 만든다 (구도·디테일이 더 정확하다). 사용자에게는 영상 하나만 보인다. false 면 글만으로 영상을 만든다
# 영상을 소리 포함(LTX-2.5, 최대 20초)으로 만드는 것이 기본이다. 화면의 소리 칸(자동·포함·없음)이 우선. false 면 소리 없는 Wan 이 기본
STUDIO_SOUND_DEFAULT=true
STUDIO_T2V_VIA_IMAGE=true
# 대사 영상 (11-19): 대화·대사가 있는 긴 영상을 '목소리 먼저 녹음 → 말하는 장면은 그 소리로 입 맞춤 → 디졸브·대사·자막으로 합치기' 로 만든다.
# 채팅 작업공간(studio-chat)에 ComfyUI-QwenTTS 노드와 transformers 4.57.3 을 넣은 뒤 true 로 (docs/short-film-dialogue-design.md 12절)
STUDIO_DIALOGUE=false
# 인물 라이브러리 파일 (정해진 인물의 외형·목소리·기준 그림·그림체). 비우면 hub/app/cast_library.json
STUDIO_CAST_FILE=
# 대사 녹음의 복제 방식 (11-19): icl = 기준 소리와 그 글을 함께 줘서 말투·나이·감정까지 따른다(기본), xvector = 목소리 특징만 복제한다
# (11-19 메인 시험 2에서 xvector 로 인사말 기준 소리를 복제하니 80세 푸토르가 젊은 목소리로 나왔다). 듣고 마음에 드는 쪽으로 바꾼다
STUDIO_VOICE_CLONE=icl
STUDIO_ASK_LONG_SECONDS=300
STUDIO_PLAN_TTL_HOURS=24
# 결과 검사: on / idle(대기열에 다른 ComfyUI 줄이 없을 때만) / off (D15). 검사에서 문제가 나오면 자동으로 다시 만드는 횟수
STUDIO_INSPECT=idle
STUDIO_AUTO_REROLL=0
# 진행 이벤트 최소 간격(ms)
STUDIO_PROGRESS_MIN_INTERVAL_MS=500
# 지운 대화를 실제로 지우기까지 날짜, 노드 시간 기록(node_timing) 보관 날짜
STUDIO_PURGE_DAYS=30
STUDIO_EVENTS_KEEP_DAYS=90
# 진행 메시지 원문 기록 (시험용, 관리자만). 폴더를 비우면 <MGS_ENVS>/state/<STUDIO_ENV_SLUG>/records, 7일 보관
STUDIO_RECORD_EVENTS=false
STUDIO_RECORD_DIR=
# (D20 결정 뒤) 허브 시간대. 결과 날짜 폴더에 쓰인다
# TZ=KST-9
