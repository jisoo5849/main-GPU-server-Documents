# 메인 GPU 서버 설정. 이 파일을 .env로 복사한 뒤 값을 바꾼다.
#   cp .env.example .env

# ── 저장소 경로 (install/02-storage.sh 가 만든다) ──
# 환경(ComfyUI·노드·Python)과 스냅샷. 반드시 btrfs 파티션이어야 한다.
MGS_ENVS=/srv/envs
# 공용 모델 저장소. NVMe 권장. 컨테이너에는 읽기 전용으로 연결된다.
MGS_MODELS=/srv/models
# 결과 저장소. Samba \\main\results 로 공유되며 누구나 읽기·쓰기 가능.
MGS_RESULTS=/srv/results
# PostgreSQL 데이터
MGS_PG=/srv/pg
# 편집·실행 컨테이너에 읽기 전용으로 연결되는 공용 파일(모델 경로 설정, 브리지 노드)
MGS_RUNTIME=/opt/mgs

# ── 사용자 그룹 (02-storage.sh 와 같은 값) ──
MGS_GROUP=comfyusers
MGS_GID=2000

# ── DB ──
POSTGRES_PASSWORD=change-this-password

# ── 허브 ──
# 세션 서명 등에 쓰는 비밀값. 아래 명령으로 만든다: openssl rand -hex 32
HUB_SECRET=change-this-secret
# 메인 주소(작업자 PC에서 접속하는 이름 또는 IP)
HUB_PUBLIC_HOST=main
# 로그인·모델 선택 화면 포트
HUB_PORTAL_PORT=80
# LLM·임베딩 중계 포트 (Ollama와 같은 주소 형식)
HUB_LLM_PORT=11434
# 사용자·프로젝트 환경마다 하나씩 쓰는 포트 범위
HUB_ENV_PORT_START=8101
HUB_ENV_PORT_END=8130

# ── ComfyUI 환경 ──
COMFY_RUNTIME_IMAGE=mgs/comfy-runtime:1
COMFY_TAG=v0.42.5
COMFY_TEMPLATE=comfy-v0.42.5-cu130
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# 편집 화면에서 CUDA가 없어 못 불러온 노드가 있어도 실행 접수를 허용 (실제 검사는 실행 공간에서 다시 한다)
ACCEPT_MISSING_NODES=true

# ── GPU 규칙 ──
GPU_INDEX=0
# 작업 하나의 최대 실행 시간(초). 긴 영상 작업에 맞춰 조정
JOB_MAX_SECONDS=14400
# 메모리 해제 확인 여유값(MB)
VRAM_WORKER_MARGIN_MB=512
VRAM_TOTAL_MARGIN_MB=768
VRAM_IDLE_MARGIN_MB=256

# ── Ollama ──
# 설치 후 실제 사용하는 버전으로 고정하는 것을 권장
OLLAMA_VERSION=latest
OLLAMA_UPSTREAM=http://127.0.0.1:11435

# ── 네트워크 ──
# 접속을 허용할 사무실 네트워크 대역
LAN_SUBNET=192.168.0.0/24
EDITOR_SUBNET=172.30.0.0/24
WORKER_SUBNET=172.30.1.0/24
